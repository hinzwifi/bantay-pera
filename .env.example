# ==============================================================================
# BANTAY-PERA CIVIC ENGINE & SEEDBOX CURATOR ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this template to .env and customize secrets.
# NEVER commit your production .env file to public version control!

# Server Listening Port & Mode
PORT=3000
NODE_ENV=production

# SQLite Database Location
DATABASE_PATH=../data/bantay_pera.db

# Master Administrative Bearer Token (Cryptographic API Access)
# Used for direct API access or automated backup scripts
ADMIN_TOKEN=bantay-sec-token-CHANGE-THIS-IN-PRODUCTION-7b98d2e4f

# Initial Admin Web Account (Argon2id Protected)
# On first boot, these credentials are automatically digested into Argon2id:
ADMIN_DEFAULT_USERNAME=admin
ADMIN_INITIAL_PASSWORD="CivicForensics2026!SecureKey#Argon2"

# Argon2id Tuning Parameters (NIST / OWASP Standard)
# Memory-hard parameters designed to resist GPU/ASIC cracking
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Admin Web Session Lifetime (Hours)
SESSION_TTL_HOURS=12

# Rate Limiting & Anti-Spam (Per 15-Minute Rolling Window)
MAX_SUBMISSIONS_PER_WINDOW=15
